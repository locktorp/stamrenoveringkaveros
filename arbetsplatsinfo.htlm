<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="UTF-8">
<title>Arbetsplatsinfo</title>

<link rel="stylesheet" href="style.css">

<style>

body{
margin:0;
}

/* container */
.viewer{
position:fixed;
top:0;
left:0;
width:100%;
height:100%;
background:#000;
}

/* PDF */
.viewer iframe{
width:100%;
height:100%;
border:none;
}

/* desktop header offset */
@media (min-width:768px){
.viewer{
top:80px;
height:calc(100% - 80px);
}
}

</style>

</head>

<body>

<div id="header-container"></div>

<div class="viewer">
<iframe src="arbetsplatstavla.pdf"></iframe>
</div>

<script>
fetch("./header.html")
.then(res => res.text())
.then(data => {
document.getElementById("header-container").innerHTML = data
})
</script>

</body>
</html>
